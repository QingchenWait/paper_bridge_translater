{
  "name": "paper-bridge",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node tools/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:dist": "node tools/verify-dist.mjs",
    "format": "prettier --write src/js src/styles tests tools/*.mjs index.html vite.config.js playwright.config.js package.json .prettierrc.json",
    "check": "node tools/check.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "vite": "^8.3.0"
  }
}
